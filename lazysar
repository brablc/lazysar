#!/usr/bin/env bash

SCRIPT_PATH=$(readlink -f "$0")
SCRIPT_DIR=${SCRIPT_PATH%/*}
RUN_DIR=/var/run/lazysar
RUN_CMDS="$RUN_DIR/${USER}-commands"
DEFAULTS_FILE="$HOME/.config/lazysar/defaults"
if [ ! -f "$DEFAULTS_FILE" ]; then
  DEFAULTS_FILE="$SCRIPT_DIR/defaults"
fi
PRESETS_FILE="$HOME/.config/lazysar/presets.json"
if [ ! -f "$PRESETS_FILE" ]; then
  PRESETS_FILE="$SCRIPT_DIR/presets.json"
fi

function check_tmux() {
  if ! command -v tmux >/dev/null; then
    echo "This command requires tmux to be installed!"
    exit 1
  fi
}

if [ "$1" = "panel" ]; then
  shift

  if [[ "$1" == "-l" || "$1" == "--list" ]]; then
    LAYOUT_DIRS=("$HOME/.config/lazysar/layouts" "$SCRIPT_DIR/layouts")
    for LAYOUT_DIR in "${LAYOUT_DIRS[@]}"; do
      if [[ -d "$LAYOUT_DIR" ]]; then
        for f in "$LAYOUT_DIR"/*.sh; do
          [[ -f "$f" ]] && basename "$f" .sh
        done
      fi
    done | sort -u
    exit
  fi

  check_tmux
  mkdir -p $RUN_DIR

  if [[ $1 =~ ^- ]]; then
    LAYOUT=basic
  else
    LAYOUT=${1-basic}
    shift
  fi

  if [ $# -ne 0 ]; then
    printf '%s ' "$@" | sed 's/ $/\n/' >"$RUN_CMDS"
  else
    cat "$DEFAULTS_FILE" >"$RUN_CMDS"
  fi

  LAYOUT_DIRS=("$HOME/.config/lazysar/layouts" "$SCRIPT_DIR/layouts")
  for LAYOUT_DIR in "${LAYOUT_DIRS[@]}"; do
    LAYOUT_PATH="${LAYOUT_DIR}/${LAYOUT}.sh"
    if [[ -f $LAYOUT_PATH ]]; then
      break
    fi
  done
  if [[ ! -f $LAYOUT_PATH ]]; then
    echo "Cannot find tmux layout in any of: ${LAYOUT_DIRS[*]}"
    exit 1
  fi

  if [[ -n $TMUX ]]; then
    bash "$LAYOUT_PATH"
  else
    SESSION="lazysar-$$"
    COLS=$(tput cols 2>/dev/null || echo 220)
    LINES=$(tput lines 2>/dev/null || echo 50)
    tmux new-session -d -s "$SESSION" -x "$COLS" -y "$LINES"
    TMUX_SESSION="$SESSION" bash "$LAYOUT_PATH"
    tmux kill-window -t "${SESSION}:0" 2>/dev/null || true
    tmux attach-session -t "$SESSION"
  fi
  exit
fi

if [ "$1" = "client" ]; then
  shift
  touch "$RUN_CMDS"

  while read -r COMMANDS; do
    if [ "$COMMANDS" == "STOP" ]; then
      break
    fi
    # shellcheck disable=SC2294
    eval lazysar "$@" "--watch='$RUN_CMDS' --title='' --panelized $COMMANDS"
  done < <(tail -n 1 -f "$RUN_CMDS" 2>/dev/null)
  exit
fi

function stop_clients() {
  echo STOP >"$RUN_CMDS"
  tmux kill-window
}

if [ "$1" = "cmd" ]; then
  shift
  sleep 2
  LAST_COMMAND=$(tail -1 "$RUN_CMDS")
  trap stop_clients EXIT
  if command -v rlwrap >/dev/null; then
    (sleep 0.1 && tmux send-keys -- "$LAST_COMMAND") &
    while true; do
      echo "Send args to panels (ENTER for defaults, history C-r, C-c to exit):"
      rlwrap -C lazysar "$SCRIPT_PATH" rlwrap || exit
    done
  else
    (sleep 1 && tmux send-keys "echo \"$LAST_COMMAND\" > $RUN_CMDS") &
    $SHELL
  fi
  exit
fi

if [ "$1" = "rlwrap" ]; then
  shift
  echo -n "> "
  read -r COMMAND
  if [ -z "$COMMAND" ]; then
    COMMAND="$(cat "$DEFAULTS_FILE")"
    echo "Using defaults from $DEFAULTS_FILE: $COMMAND"
  fi
  echo "$COMMAND" >>"$RUN_CMDS"
  if [ "$COMMAND" = "STOP" ]; then
    exit 1
  fi
  exit
fi

if [ ! -d "${SCRIPT_DIR}/.venv/bin" ]; then
  echo "Python virtual environment not setup properly, did you run install.sh?"
  exit 1
fi
FORCE_COLOR=1 "${SCRIPT_DIR}/.venv/bin/python" "${SCRIPT_DIR}/lazysar.py" --presets-file="${PRESETS_FILE}" "$@"
